#!/usr/bin/env bash
# ==============================================================================
# DottedIce Digital — Pre-Commit Secret & Exposure Scanner
# Part of the "5 Rules for Total Non-Exposure" Security Architecture
# ==============================================================================

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}🔍 Running pre-commit security audit on staged files...${NC}"

# 1. Prohibit committing .env or backup files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

FORBIDDEN_FILES=()
for file in $STAGED_FILES; do
    case "$file" in
        *.env*|*.bak|*.backup|*.old|*.tmp|*.csv|*database.sqlite*|*recovery*)
            FORBIDDEN_FILES+=("$file")
            ;;
    esac
done

if [ ${#FORBIDDEN_FILES[@]} -ne 0 ]; then
    echo -e "${RED}❌ COMMIT REJECTED: Sensitive or temporary files cannot be committed:${NC}"
    for f in "${FORBIDDEN_FILES[@]}"; do
        echo -e "   - $f"
    done
    echo -e "${YELLOW}Please remove these files with 'git reset HEAD <file>' or add them to .gitignore.${NC}"
    exit 1
fi

# 2. Scan staged content for credential patterns
VIOLATIONS=0

scan_pattern() {
    local pattern="$1"
    local description="$2"
    
    local matches
    matches=$(git diff --cached -U0 | grep -E "^\+" | grep -v "^\+\+\+" | grep -E -e "$pattern" || true)
    
    if [ -n "$matches" ]; then
        echo -e "${RED}❌ VIOLATION FOUND: $description${NC}"
        echo "$matches" | head -n 5 | while read -r line; do
            echo -e "   ${RED}$line${NC}"
        done
        VIOLATIONS=$((VIOLATIONS + 1))
    fi
}

# Scan for Private Keys
scan_pattern "-----BEGIN (RSA |EC |OPENSSH |PGP )?PRIVATE KEY-----" "Private cryptographic key detected"

# Scan for Database connection strings with passwords
scan_pattern "postgres(ql)?:\/\/[^:]+:[^@]+@" "PostgreSQL connection string with embedded password detected"

# Scan for recovery codes or high entropy hex strings in files
scan_pattern "(npm_recovery|[a-f0-9]{64})" "Plaintext recovery code or private token detected"

# Scan for Web3Forms access keys in code
scan_pattern "[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}" "Exposed Web3Forms access key UUID detected"

# Scan for hardcoded fallback secrets (e.g. process.env.SECRET || 'secret')
scan_pattern "process\.env\.[A-Z_]+[[:space:]]*\|\|[[:space:]]*['\"][a-zA-Z0-9_\-]{8,}['\"]" "Hardcoded fallback secret in environment assignment"

# Scan for sensitive prefixes
scan_pattern "(NEXT_PUBLIC|VITE|REACT_APP)_(SECRET|PASSWORD|PRIVATE|DATABASE|TOKEN|KEY_SECRET)" "Sensitive variable marked with client-side public prefix"

if [ $VIOLATIONS -ne 0 ]; then
    echo -e "\n${RED}🛑 Commit aborted due to security policy violations.${NC}"
    echo -e "All secrets must reside exclusively in server-side environment variables."
    echo -e "Refer to SECURITY_POLICY.md for guidelines.\n"
    exit 1
fi

echo -e "${GREEN}✅ Pre-commit security scan passed. No exposed secrets detected.${NC}"
exit 0
